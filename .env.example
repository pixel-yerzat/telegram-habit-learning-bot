# Telegram Bot Token (obtain from https://t.me/BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Google Gemini API Key for AI tests and material verification (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Database file location
DB_PATH=./data/bot.sqlite

# Default user timezone offset (e.g. +05:00 for Almaty/Tashkent, +03:00 for Moscow)
DEFAULT_TIMEZONE=+05:00

# Default reminder times (24h format HH:MM)
DEFAULT_MORNING_REMINDER=09:00
DEFAULT_EVENING_REMINDER=21:00

# Weekly review time (Sunday 20:00)
WEEKLY_REVIEW_DAY=0
WEEKLY_REVIEW_TIME=20:00
